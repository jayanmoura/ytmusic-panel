[Unit]
Description=YouTube Music daemon for the ytmusic-panel GNOME extension
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.jayanmoura.YTMusic
ExecStart=%h/.local/share/ytmusic-daemon/venv/bin/ytmusic-daemon
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
